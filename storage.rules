rules_version = '2';

/**
 * Firebase Storage Rules - READ-ONLY for Memorial
 * 
 * These rules block all uploads and modifications while allowing
 * public read access to existing files for the memorial.
 */

service firebase.storage {
  match /b/{bucket}/o {
    
    // Global read access - anyone can view existing files
    match /{allPaths=**} {
      allow read: if true;
      
      // NO WRITES ALLOWED - Memorial is read-only
      allow write: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}


